From quay.io/simbelmas/fedora-minimal:v42.26@sha256:8632e9f6356749019120ef0e3082fe5bbbce37bee6c292eb8377b3936e3ba342 AS Base

From Base as Builder


RUN microdnf --nodocs --best -y install go \
    && microdnf clean all
RUN mkdir app && cd /app \
    && go install -v github.com/flatcar/fleetlock@latest \
    && ls -al

FROM Base

RUN echo 'app:x:1001:' >> /etc/group \
    && echo 'app:x:1001:1001::/app:/sbin/nologin' >> /etc/passwd \
    && mkdir -p /app \
    && chmod -R 755 /app \ 
    && chown -R app:app /app 

COPY --from=Builder --chmod=0755 /root/go/bin/fleetlock /usr/local/bin/fleetlockctl

USER 1001

WORKDIR /app

LABEL maintainer "Simon Belmas <slos@soket.fr>"

ENTRYPOINT ["fleetlockctl"]