# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v43.41@sha256:7eaad46179c8cebdf3710f8bc2416cf522c51d8cc78b2f86acc5e7738390a008 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]