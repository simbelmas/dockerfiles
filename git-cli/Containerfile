# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v43.42@sha256:3ab7e4996daf363a91e17aab0f90bb856568fc2f09a2a350e4366fa710556b7d AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]