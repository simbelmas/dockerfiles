# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.15@sha256:8f422c3944b3534f7c9b7a591d0170503fd4e2426b0f34d62be467f3d3b4baed AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]