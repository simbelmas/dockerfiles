# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.11@sha256:1db07352a5ab9ef45d58599340d6e1d48368f5057e4d0bbe879c4380c000bfbc AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]