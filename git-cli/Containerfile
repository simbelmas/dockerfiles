# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.3@sha256:47c19e969cf610f3d61924c9162eb6f284a41859ad258bedef4e0b50ccae45a5 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]