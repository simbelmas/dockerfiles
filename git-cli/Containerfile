# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.2@sha256:1cef69e363d0259f73866a024958df4b4188ca32fcb65db978723b4e93ea2ed0 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]