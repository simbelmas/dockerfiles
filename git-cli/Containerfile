# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v43.43@sha256:cbe23fb37b3860475f63c8648e7ccf3e61360b9ce38aa1d720fa763e1d87eb74 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]