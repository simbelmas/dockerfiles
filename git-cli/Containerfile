# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.18@sha256:36203893a6b3281ff15a0c239e7d3839a35199b80581bbea179766674ab5daee AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]