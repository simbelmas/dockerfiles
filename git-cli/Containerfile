# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.17@sha256:5b66102e6ad3c2c2b88837a12c8856c24011b1393f107a24cd881ddc4ab620f0 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]