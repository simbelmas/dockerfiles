# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v44.21@sha256:27ee5f74da56e4f7b558b6991be1451972bafad601976ce9bfd3118290e11545 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    git-core git-crypt ca-certificates \
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /
ENV GIT_SSH_COMMAND="ssh -i /ssh/ssh-privatekey -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/ssh/known_hosts"
RUN rm /etc/ssh/ssh_config.d/* || echo "no additional ssh config files to delete" \
    && echo 'app:x:1001:1001::/tmp:/sbin/nologin' >> /etc/passwd 
USER 65534
ENTRYPOINT ["/usr/bin/git"]
CMD ["--help"]