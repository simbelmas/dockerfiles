FROM quay.io/simbelmas/fedora-minimal:v44.4@sha256:26983817928717e4c74508df084ffcd63951ac06d7d2682a986c08d88c49b780 AS Builder

ARG HUGO_ARCH=amd64
RUN microdnf --nodocs --best -y install \
    curl tar gzip ca-certificates

RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    ca-certificates glibc libstdc++ libgcc tzdata \
    && dnf --installroot=/target clean all

# Dernière release Hugo **extended** (API GitHub) → binaire dans PATH
# PLATFORMS actuel : linux/amd64 (voir build-params). Pour arm64 : remplacer amd64 par arm64 dans l’URL.
RUN set -eux; \
    TAG="$(curl -sSL -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' \
      https://api.github.com/repos/gohugoio/hugo/releases/latest \
      | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\(v[^"]*\)".*/\1/p' | head -n1)"; \
    test -n "${TAG}"; \
    VER="${TAG#v}"; \
    curl -sSL "https://github.com/gohugoio/hugo/releases/download/${TAG}/hugo_extended_${VER}_linux-${HUGO_ARCH}.tar.gz" -o /tmp/hugo.tgz; \
    tar -xzf /tmp/hugo.tgz -C /tmp hugo; \
    mv /tmp/hugo /target/usr/local/bin/hugo; \
    chmod 755 /target/usr/local/bin/hugo; \
    rm -f /tmp/hugo.tgz

FROM scratch

LABEL maintainer "Simon Belmas <slos@soket.fr>"

COPY --from=Builder /target /
USER 1001
WORKDIR /hugosource

ENTRYPOINT [ "/usr/local/bin/hugo" ]
CMD [ "--gc", "--destination=/output",  "--cleanDestinationDir" ]
