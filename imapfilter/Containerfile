FROM quay.io/simbelmas/fedora-minimal:v43.33@sha256:e02d586d27bb43d1c941017af54caca1e555f49fc4cf951df8c986652a927abb AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    imapfilter python3-jinja2-cli\
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /

COPY --chmod=0444 run.lua /app/run.lua

USER 1001

ENTRYPOINT ["/usr/bin/imapfilter"]
CMD ["-c", "/app/run.lua"]
