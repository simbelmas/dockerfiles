FROM quay.io/simbelmas/fedora-minimal:v44.15@sha256:8f422c3944b3534f7c9b7a591d0170503fd4e2426b0f34d62be467f3d3b4baed AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
    --setopt=install_weak_deps=False \
    --use-host-config \
    install \
    imapfilter python3-jinja2-cli\
    && dnf --installroot=/target clean all

# Stage 2: Final image
FROM scratch
COPY --from=builder /target /

COPY --chmod=0444 run.lua /app/run.lua

USER 1001

ENTRYPOINT ["/usr/bin/imapfilter"]
CMD ["-c", "/app/run.lua"]
