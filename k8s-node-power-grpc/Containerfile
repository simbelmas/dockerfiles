FROM quay.io/simbelmas/fedora-minimal:v44.30@sha256:c431e0823da9d8b24b0ff739a014321809d1b1bc75909ac63476759d98aa36dd AS Builder

ARG TARGETARCH=amd64
ARG GO_VERSION=1.26.6
ARG GIT_REPO=https://git.spdnova.xyz/Sok3t/k8s-node-power-grpc.git
ARG GIT_REF=main

RUN microdnf --nodocs --best -y install \
    curl tar gzip ca-certificates git \
    && microdnf clean all

RUN set -eux; \
    curl -sSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz

ENV PATH=/usr/local/go/bin:$PATH \
    GOPROXY=https://proxy.golang.org,direct \
    CGO_ENABLED=0 \
    GOOS=linux

WORKDIR /src
RUN git clone --depth 1 --branch "${GIT_REF}" "${GIT_REPO}" .
RUN go build -trimpath -ldflags="-s -w" -o /grpc-daemon ./cmd/grpc-daemon

# Runtime is fedora-minimal (not scratch): nsenter from util-linux joins pid 1's
# mount namespace so lvs/lvremove see host VGs. The Go process cannot
# setns(CLONE_NEWNS) itself (multithreaded → EINVAL).
FROM quay.io/simbelmas/fedora-minimal:v44.30@sha256:c431e0823da9d8b24b0ff739a014321809d1b1bc75909ac63476759d98aa36dd

LABEL maintainer "Simon Belmas <slos@soket.fr>"

RUN microdnf --nodocs --best -y install util-linux \
    && microdnf clean all

COPY --from=Builder /grpc-daemon /usr/local/bin/grpc-daemon

USER 0
ENTRYPOINT ["/usr/local/bin/grpc-daemon"]
