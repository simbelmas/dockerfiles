# Stage 1: Build the rootfs
FROM quay.io/simbelmas/fedora-minimal:v43.36@sha256:a6977044828cf7c9ece84b36370baf1a136f50ba9115ab98d401da89b71c8244 AS builder
RUN mkdir /target
RUN dnf -y --installroot=/target \
--setopt=install_weak_deps=False \
--use-host-config \
install \
bash ca-certificates \
&& dnf --installroot=/target clean all
RUN cd /target/usr/local/bin \
    && curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
    && chmod a+x kubectl

# Stage 2: Final image
FROM scratch
LABEL maintainer "Simon Belmas <slos@soket.fr>"
COPY --from=builder /target /
USER 1001
ENTRYPOINT ["/usr/local/bin/kubectl"]
CMD ["--help"]

