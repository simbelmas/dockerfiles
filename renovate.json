{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "renovatebot"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "prHourlyLimit": 50,
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Generic rule for all Quadlet files: allow tag updates but disable digest pinning",
      "matchFileNames": ["**/*.container"],
      "pinDigests": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "ignoreTests": true
    }
  ],
  "ignorePaths": [
    "transmission/**",
    "mosquitto/**",
    "home-assistant/**",
    "ubuntu/**",
    "tekton-test/**",
    "stress-ng/**",
    "alpinetex/**"
  ]
}