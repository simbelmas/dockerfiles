[Unit]
Description=Apply bootc updates using fleetlock
Documentation=man:bootc(8)
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/bootc-fleetlock-fetch-apply-upgrade
## this service had to be enhanced with drop ins to provide NODE_UPGRADE_FLEETLOCK_GROUP and installed into a target