FROM olareg.skh.spdnova.xyz/skh-infra-kube:v43.35@sha256:fa65316dfe03dfb47a24742c2894bbe5c8d419a04a158e41d19d3f7fa71b6202 AS Base

FROM Base
ENV CEPH_RELEASE=20.2.0

RUN curl --silent --output /usr/sbin/cephadm --location https://download.ceph.com/rpm-${CEPH_RELEASE}/el9/noarch/cephadm \
    && chmod 555 /usr/sbin/cephadm
RUN echo 'alias ceph=cephadm shell -- ceph' >>  /etc/profile.d/ceph_alias.sh

RUN bootc container lint --fatal-warnings