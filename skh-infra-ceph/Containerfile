FROM olareg.skh.spdnova.xyz/skh-infra-kube:v43.87@sha256:077dbc38dd6e6c2f1694d1296fa4ec464c6e49cb416a40ba14a7d9601ebf3578 AS Base

FROM Base
ENV CEPH_RELEASE=20.2.2

RUN curl --silent --output /usr/sbin/cephadm --location https://download.ceph.com/rpm-${CEPH_RELEASE}/el9/noarch/cephadm \
    && chmod 555 /usr/sbin/cephadm
COPY config/ceph-aliases.sh /etc/profile.d/
COPY --chmod=0700 ./scripts/manage-ceph-deploy.sh /usr/local/bin/
COPY --chmod=0700 ./scripts/zap-host-disks.sh /usr/local/bin/
COPY --chmod=0700 ./scripts/var-disk-cleanup.sh /usr/local/bin/
COPY --chmod=0700 ./scripts/recreate-local-mon /usr/local/bin/
COPY ./systemd-units/ceph-node-lifecycle.service /usr/lib/systemd/system/
COPY ./systemd-units/var-disk-cleanup.service /usr/lib/systemd/system/
COPY ./systemd-units/var-disk-cleanup.timer /usr/lib/systemd/system/
RUN systemctl enable ceph-node-lifecycle.service &&\
    systemctl enable var-disk-cleanup.timer

COPY ./systemd-units/drop-in-kubernetes-node-lifecycle.conf /usr/lib/systemd/system/kubernetes-node-lifecycle.service.d/

RUN --mount=type=tmpfs,target=/run \
    for service in \
        var-disk-cleanup.service  \
        var-disk-cleanup.timer \
    ; do \
        echo "Checking svc ${service}"; \
        systemd-analyze verify "/usr/lib/systemd/system/${service}" || exit 1 ; \
        systemctl enable "${service}" || exit 1; \
    done
RUN bootc container lint --fatal-warnings