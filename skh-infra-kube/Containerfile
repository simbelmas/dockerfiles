FROM olareg.skh.spdnova.xyz/skh-infra-base:v44.20@sha256:c942be4fd9e54011e2f659350bbc0cb439faf5ea50d6739638c5c59637fc7322 AS Base

FROM Base
ENV KUBERNETES_MINOR_VERSION=1.35
## KUBERNETES_PATCH_VERSION: when empty follows fedora release lifecycle for patches
ENV KUBERNETES_PATCH_VERSION=""

RUN dnf5 --nodocs -y install \
        python3 policycoreutils-python-utils \
        nvtop \
        container-selinux \
        selinux-policy-targeted \
        cri-o${KUBERNETES_MINOR_VERSION}${KUBERNETES_PATCH_VERSION} kubernetes${KUBERNETES_MINOR_VERSION}${KUBERNETES_PATCH_VERSION} kubernetes${KUBERNETES_MINOR_VERSION}-kubeadm${KUBERNETES_PATCH_VERSION} \
        qemu-user-static qemu-user-binfmt &&\
    dnf5 clean all &&\
    rm -rf /run/dnf /var/cache/* /var/lib/dnf /var/log/dnf5.log &&\
    rm -rf /var/lib/containers /var/lib/kubelet

COPY systemd-units/var-lib-kubelet.conf /usr/lib/tmpfiles.d/
## mapping /opt is needed for crio to run
RUN rm -rvf /opt &&\
    ln -s /var/opt /opt

COPY ./config/modules.crio-o.conf /usr/lib/modules-load.d/cri-o.conf
COPY ./config/sysctl-kubernetes.conf /usr/lib/sysctl.d/kubernetes.conf
COPY ./config/profile.sh /etc/profile.d/
RUN mkdir -p /etc/kubernetes/{kube-api-config,fedora-kube.d} &&\
    echo "KUBERNETES_DESIRED_VERSION=${KUBERNETES_MINOR_VERSION}" > /etc/kubernetes/fedora-kube.d/fedora-kube-cluster.conf 
COPY --chmod=0600 ./config/admission-control-config.yaml /etc/kubernetes/kube-api-config/
COPY --chmod=0600 ./config/encryption-at-rest-configuration.yaml /etc/kubernetes/kube-api-config/
COPY ./config/crio-bridge.conflist /etc/cni/net.d/100-crio-bridge.conflist

COPY ./systemd-units/kubernetes-node-lifecycle.service /usr/lib/systemd/system/
COPY ./systemd-units/kubeadm-tmp-cleanup.service /usr/lib/systemd/system/
COPY --chmod=0700 ./scripts/kubeadm-tmp-cleanup.sh /usr/local/bin/
RUN mkdir -p /usr/lib/systemd/system/kubernetes-node-lifecycle.service.d
COPY ./systemd-units/drop-in-kubernetes-node-lifecycle.conf /usr/lib/systemd/system/kubernetes-node-lifecycle.service.d/kubeadm-tmp-cleanup.conf
COPY --chmod=0700 ./scripts/kube-node-postinstall /usr/sbin/
COPY --chmod=0700 ./scripts/manage_kubernetes_controlplane_lifecycle.sh /usr/local/lib/
COPY --chmod=0700 ./scripts/manage_kubernetes_worker_lifecycle.zsh /usr/local/lib/
COPY --chmod=0700 ./scripts/manage-node-lifecycle.zsh /usr/local/lib/

RUN --mount=type=tmpfs,target=/run \
    for service in \
        kubelet.service \
        crio.service \
        kubernetes-node-lifecycle.service \
        kubeadm-tmp-cleanup.service \
        bootc-fleetlock-fetch-upgrade.service \
        bootc-fleetlock-fetch-upgrade.timer \
    ; do \
        echo "Checking svc ${service}"; \
        systemd-analyze verify "/usr/lib/systemd/system/${service}" || exit 1 ; \
        systemctl enable "${service}" || exit 1; \
    done

RUN systemctl disable bootc-fetch-apply-updates.timer &&\
    systemctl mask bootc-fetch-apply-updates.service

RUN rm /usr/lib/systemd/system/default.target.wants/bootc-fetch-apply-updates.timer
    
## Gpu selinux /var/lib/cdi + temporary CRI-O execmem workaround (see config/selinux/crio-execmem-workaround.cil)
COPY config/gpu/cdi.cil /tmp/cdi.cil
COPY config/selinux/crio-execmem-workaround.cil /tmp/crio-execmem-workaround.cil
RUN semodule -i /tmp/cdi.cil /tmp/crio-execmem-workaround.cil \
    && rm -f /tmp/cdi.cil /tmp/crio-execmem-workaround.cil
    
# BMAX kargs i915 kernel module
# uses systemd service and a script to position kernel argument on specific nodes.
COPY --chmod=0755 config/gpu/bootc-node-kargs.sh /usr/libexec/
COPY config/gpu/bootc-node-kargs.service /usr/lib/systemd/system/
COPY config/gpu/90-bootc-node-kargs.preset /usr/lib/systemd/system-preset/
RUN --mount=type=tmpfs,target=/run \
    systemd-analyze verify "/usr/lib/systemd/system/bootc-node-kargs.service" &&\
    systemctl enable bootc-node-kargs.service

RUN bootc container lint --fatal-warnings