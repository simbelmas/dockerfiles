FROM olareg.skh.spdnova.xyz/skh-infra-base:v43.29@sha256:407fa8808649472f7dd4c95230e7c87529a86c044c1a3b49eb64a4e5e8d6700e AS Base

FROM Base

RUN microdnf --nodocs --best -y install \
        python3 \
        rsync &&\
    microdnf clean all

COPY --chmod=0755 scripts/rrsync /usr/local/bin/
COPY users/backup_users.conf /usr/lib/sysusers.d

## Pxe scripts and configurations
COPY --chmod=0644 config/alias-pxe.sh /usr/etc/profile.d/
RUN mkdir -p /usr/local/share/gitea_ssh/.ssh &&\
    chown 0700 -R /usr/local/share/gitea_ssh 
COPY --chmod=0600 config/gitea_ssh_config /usr/local/share/gitea_ssh/.ssh/config
COPY --chmod=0600 config/gitea_known_hosts /usr/local/share/gitea_ssh/.ssh/known_hosts
COPY systemd-units/static-gitea-ssh.conf /usr/lib/systemd/system/update-static-files.service.d/

## Systemd PXE management
COPY systemd-units/var-srv-backup.automount /usr/lib/systemd/system/
COPY systemd-units/var-srv-backup.mount /usr/lib/systemd/system/
COPY systemd-units/pxe-configuration-generate-pxe-chain.container /usr/share/containers/systemd/
COPY systemd-units/pxe-configuration-generate-pxe-chain.timer /usr/lib/systemd/system/
COPY systemd-units/pxe-configuration-ipxe-server.container /usr/share/containers/systemd/
COPY systemd-units/pxe-configuration-manage-assets.container /usr/share/containers/systemd/
COPY systemd-units/pxe-configuration-update-manager.container /usr/share/containers/systemd/
COPY systemd-units/olareg.container /usr/share/containers/systemd/

## Seasweedfs Management
COPY systemd-units/seaweedfs.container /usr/share/containers/systemd/

## Enabling previous configuration in systemd
RUN cd /usr/lib/systemd/system/multi-user.target.wants &&\
    ln -vs /usr/lib/systemd/system/var-srv-backup.automount /usr/etc/systemd/system/multi-user.target.wants/ &&\
    ln -vs /usr/lib/systemd/system/pxe-configuration-generate-pxe-chain.timer /usr/etc/systemd/system/multi-user.target.wants/

## Manage static files update
# users homedirs
## skh user
RUN mkdir -p /usr/local/share/skh/.ssh &&\
    chmod 0700 /usr/local/share/skh &&\
    chown 1001:1001 -R /usr/local/share/skh
COPY --chown=1001:1001 --chmod=0600 users/authorized_keys /usr/local/share/skh/.ssh/authorized_keys

## francois user
RUN mkdir -p /usr/local/share/francois/.ssh &&\
    chmod 0700 /usr/local/share/francois &&\
    chown 1002:1002 -R /usr/local/share/francois
COPY --chown=1002:1002 --chmod=0600 users/authorized_keys /usr/local/share/francois/.ssh/authorized_keys


## seaweedfs user
RUN mkdir -p /usr/local/share/seaweedfs/.config/seaweedfs &&\
    chmod 0700 /usr/local/share/seaweedfs &&\
    chown 1003:1003 -R /usr/local/share/seaweedfs

##sync homedirs
COPY systemd-units/backup-users-homedirs.conf /usr/lib/systemd/system/update-static-files.service.d/

# pxe dirs
RUN mkdir -p /usr/local/share/containers/pxe-utils/ /usr/local/share/containers/pxe/ /usr/local/share/containers/olareg &&\
    chmod 0755 -R /usr/local/share/containers &&\
    chmod 0700 /usr/local/share/containers/olareg &&\
    chown 1000:1000 /usr/local/share/containers/olareg

COPY --chown=root --chmod=0755 scripts/get_pxe_fedora_bootc.zsh /usr/local/share/containers/pxe-utils/
COPY --chown=root --chmod=0755 scripts/pxe-configuration-update-manager.zsh /usr/local/share/containers/pxe-utils/
COPY systemd-units/static-pxe-utils.conf /usr/lib/systemd/system/update-static-files.service.d/

RUN ln -sv /usr/lib/systemd/system/bootc-fetch-apply-updates.timer /usr/etc/systemd/system/timers.target.wants/
