[Unit]
Description=Manage hosts pxe configuration
After=local-fs.target
After=network-online.target
OnSuccess=pxe-configuration-manage-assets.service
OnSuccess=pxe-configuration-restart-ipxe-server.service

[Container]
Environment=TFTP_SERVER_ADDRESS=http://%H
Environment=RUNNING_HOST=%H
Image=quay.io/simbelmas/ipxe:stable
Pull=newer
Exec=manage_assets
Volume=/var/srv/containers/pxe:/var/www/html

[Service]
Restart=on-failure
RestartSec=10s