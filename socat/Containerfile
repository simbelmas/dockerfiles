FROM quay.io/simbelmas/fedora-minimal:v43.18@sha256:746f088ddf146ae9de2b031bb002262ba796dd21ca5e8dbeede503df7fda69cb

LABEL maintainer "Simon Belmas <slos@soket.fr>"

RUN microdnf --nodocs --best -y install socat \
    && microdnf clean all

RUN echo 'app:x:1001:' >> /etc/group \
    && echo 'app:x:1001:1001::/app:/sbin/nologin' >> /etc/passwd \
    && mkdir -p /app /app/creds /app/config \
    && chown -Rv app:app /app \
    && chmod -R 755 /app

USER 1001

ENTRYPOINT ["socat"]
CMD ["-h"]
